class student():
    name = input("Enter your name:")
    age = 14
    schoolclass = "9th"
    classteacher = "Ms. Priya"
    # these are the class variables

    #declaring the class function
    def show_detalis(self):
        print("\n The details of the students are:")
        print('name:',self.name)
        print('age:',self.age)
        print('schoolclass',self.schoolclass)
        print('classteacher',self.classteacher)

    #create a function to change the student details
    def change_details(self):
        print("\n\nPlease update your age: ")
        self.age=int(input())
        print("\nPlease update the name of the student")
        self.name=input()
        print("\n Details updated")




